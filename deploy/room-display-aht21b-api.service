# room-display-aht21b-api を systemd で常駐させるためのユニットファイル
#
# YOUR_USER を実行するユーザー名に置き換えてから /etc/systemd/system/ に配置する。
# 手順は README の「自動起動（systemd）」を参照。

[Unit]
Description=Room climate display (AHT21B API server)
# ネットワークが使えるようになってから起動する
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/room-display-aht21b-api
ExecStart=/home/YOUR_USER/room-display-aht21b-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
# 異常終了したら 5 秒後に再起動する
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
